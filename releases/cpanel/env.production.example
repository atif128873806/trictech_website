# Production template for the Tricetech public website (cPanel split layout).
#
# Copy this over .env only if you need to rebuild .env from scratch:
#   cp env.production.example .env
# The shipped .env already contains a generated APP_KEY. If you lose it, run:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# and paste the result into APP_KEY.

APP_NAME="Tricetech Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
# Inquiry notifications print their received time in this timezone.
APP_TIMEZONE=America/Toronto

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Use debug while MAIL_MAILER=log so submissions are readable in
# storage/logs/laravel.log. Switch to error once real mail delivery works.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Inquiry delivery -------------------------------------------------------
# Option 1: log only (no email is sent, the form still reports success).
# MAIL_MAILER=log

# Option 2: cPanel's local mail server. Usually works without extra settings.
# Keep the quotes around the path - an unquoted space breaks the whole .env and
# every page then returns a blank 500.
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# Option 3: a real mailbox over SMTP. Fill in the values from cPanel > Email
# Accounts > Connect Devices. Use 465 with MAIL_SCHEME=smtps, or 587 with
# MAIL_SCHEME=smtp. MAIL_ENCRYPTION is NOT read by Laravel 11+ - do not use it.
# MAIL_MAILER=smtp
# MAIL_HOST=mail.example.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=website@example.com
# MAIL_PASSWORD=

MAIL_FROM_ADDRESS="website@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where inquiry notifications are delivered. Comma separated to notify several
# mailboxes at once; each one receives its own copy of every submission, with
# reply-to set to the visitor so any of them can answer directly.
INQUIRY_RECIPIENT="info@tricetech.ca,junaid@tricetech.ca,coo@tricetech.ca"
